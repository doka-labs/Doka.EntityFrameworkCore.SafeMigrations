<Project>
  <PropertyGroup Label="Target framework and build outputs">
    <TargetFramework>net11.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <IncludeProjectNameInArtifactsPaths>true</IncludeProjectNameInArtifactsPaths>
    <UseArtifactsIntermediateOutput>true</UseArtifactsIntermediateOutput>
    <!-- WHY: Legacy local outputs and BDN-generated child sources must not enter
         SDK default globs when the repository uses centralized artifact output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/BenchmarkDotNet.Artifacts/**;**/.bdn/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Label="Compiler and analysis">
    <LangVersion>latestMajor</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Dependency restore and audit">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- WHY: Repository execution projects also need reviewed transitive graphs.
         Shipping projects disable promotion and declare their owning floors. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- WHY: Local development retains advisory warnings without promoting newly
         published findings to build errors. CI/release evaluation clears
         developer exceptions; failed advisory retrieval remains fatal. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="CI and release isolation">
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- WHY: Evaluate after CI identity. RID restores and isolated package/profile
         creation have distinct graphs; their callers explicitly lock the second restore. -->
    <RestoreLockedMode
      Condition="'$(ContinuousIntegrationBuild)' == 'true'
                 And '$(RuntimeIdentifier)' == ''
                 And '$(SafeMigrationsPackageConsumerMode)' != 'Package'">true</RestoreLockedMode>
    <!-- WHY: Evaluate after the GitHub CI flag so inherited developer exceptions
         cannot silently weaken workflow or explicit release qualification. -->
    <WarningsNotAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
  </PropertyGroup>

  <PropertyGroup Label="Project defaults">
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- WHY: Publishable source projects enable their public XML documentation separately. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
