<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WHY: BenchmarkDotNet discovers and binds workload members through reflection;
         conditional IDE annotations describe that use without runtime assets. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" IncludeAssets="compile" />
    <!-- WHY: Benchmarks share configuration source without introducing a runtime
         dependency between provider-specific benchmark assemblies or packages. -->
    <!-- WHY: BDN's generated child project references this executable and must receive its
         compile/runtime assets. No publishable package references a benchmark project. -->
    <PackageReference Include="BenchmarkDotNet" />
    <AssemblyMetadata Include="BenchmarkProjectPath" Value="$(MSBuildProjectFullPath)" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/**/*.cs" LinkBase="Infrastructure" />
    <Compile Include="$(MSBuildThisFileDirectory)../tests/Shared/DatabaseImageCatalog.cs"
             Link="Infrastructure/DatabaseImageCatalog.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../docker/database-images.Dockerfile"
                      LogicalName="Doka.SafeMigrations.DatabaseImages" />
  </ItemGroup>
</Project>
