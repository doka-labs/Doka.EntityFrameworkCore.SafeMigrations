<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.SafeMigrations.MySql</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.SafeMigrations.MySql</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Doka.EntityFrameworkCore.SafeMigrations.MySql</PackageId>
    <Description>
      MySQL and MariaDB provider for Doka.EntityFrameworkCore.SafeMigrations - safe,
      idempotent EF Core migration operations integrated through the Doka provider SPI.
    </Description>
    <PackageTags>efcore;entityframeworkcore;migrations;safe-migrations;idempotent;mysql;mariadb;doka</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Doka.EntityFrameworkCore.SafeMigrations.MySql.props"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Doka.EntityFrameworkCore.MySql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive; compile" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Doka.EntityFrameworkCore.SafeMigrations\Doka.EntityFrameworkCore.SafeMigrations.csproj" />
  </ItemGroup>

  <!-- WHY: Update-only navigation preserves SDK Compile ownership. Every parent
       is a real same-folder source; feature locations and runnable identities remain intact. -->
  <ItemGroup Label="PartialFamilyNesting">
    <Compile Update="Analysis\MySqlSafeMigrationProviderAnalyzer.*.cs">
      <DependentUpon>MySqlSafeMigrationProviderAnalyzer.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Columns\MySqlProjectedAlterPhysicalSnapshot.*.cs">
      <DependentUpon>MySqlProjectedAlterPhysicalSnapshot.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Columns\MySqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'MySqlSafeMigrationCatalogSqlBuilder.Columns'">MySqlSafeMigrationCatalogSqlBuilder.Columns.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Constraints\ForeignKeys\MySqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'MySqlSafeMigrationCatalogSqlBuilder.ForeignKeys'">MySqlSafeMigrationCatalogSqlBuilder.ForeignKeys.cs</DependentUpon>
    </Compile>
    <Compile Update="SqlGeneration\MySqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon>MySqlSafeMigrationCatalogSqlBuilder.cs</DependentUpon>
    </Compile>
    <Compile Update="SqlGeneration\MySqlSafeMigrationOperationHandler.*.cs">
      <DependentUpon>MySqlSafeMigrationOperationHandler.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
