<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</PackageId>
    <Description>
      PostgreSQL provider for Doka.EntityFrameworkCore.SafeMigrations - safe, idempotent,
      provider-aware EF Core migration operations across supported PostgreSQL versions.
    </Description>
    <PackageTags>efcore;entityframeworkcore;migrations;safe-migrations;idempotent;postgresql;npgsql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Doka.EntityFrameworkCore.SafeMigrations.PostgreSql.props"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Doka.EntityFrameworkCore.SafeMigrations\Doka.EntityFrameworkCore.SafeMigrations.csproj" />
  </ItemGroup>

  <!-- WHY: Update-only navigation preserves SDK Compile ownership. Every parent
       is a real same-folder source; feature locations and runnable identities remain intact. -->
  <ItemGroup Label="PartialFamilyNesting">
    <Compile Update="Analysis\PostgreSqlSafeMigrationProviderAnalyzer.*.cs">
      <DependentUpon>PostgreSqlSafeMigrationProviderAnalyzer.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Columns\PostgreSqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'PostgreSqlSafeMigrationCatalogSqlBuilder.Columns'">PostgreSqlSafeMigrationCatalogSqlBuilder.Columns.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Indexes\PostgreSqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'PostgreSqlSafeMigrationCatalogSqlBuilder.Indexes'">PostgreSqlSafeMigrationCatalogSqlBuilder.Indexes.cs</DependentUpon>
    </Compile>
    <Compile Update="SqlGeneration\PostgreSqlSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon>PostgreSqlSafeMigrationCatalogSqlBuilder.cs</DependentUpon>
    </Compile>
    <Compile Update="SqlGeneration\PostgreSqlSafeMigrationSqlExpressionRenderer.*.cs">
      <DependentUpon>PostgreSqlSafeMigrationSqlExpressionRenderer.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
