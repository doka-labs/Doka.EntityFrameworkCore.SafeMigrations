<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Doka.EntityFrameworkCore.SafeMigrations.PostgreSql</PackageId>
    <Description>
      PostgreSQL provider for Doka.EntityFrameworkCore.SafeMigrations - safe, idempotent,
      provider-aware EF Core migration operations across supported PostgreSQL versions.
    </Description>
    <PackageTags>efcore;entityframeworkcore;migrations;safe-migrations;idempotent;postgresql;npgsql</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <ProjectReference Include="..\Doka.EntityFrameworkCore.SafeMigrations\Doka.EntityFrameworkCore.SafeMigrations.csproj" />
  </ItemGroup>
</Project>
