<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.SafeMigrations.SqlServer</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.SafeMigrations.SqlServer</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Doka.EntityFrameworkCore.SafeMigrations.SqlServer</PackageId>
    <Description>
      SQL Server provider for Doka.EntityFrameworkCore.SafeMigrations - safe,
      idempotent, provider-aware EF Core migration operations.
    </Description>
    <PackageTags>efcore;entityframeworkcore;migrations;safe-migrations;idempotent;sqlserver</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Doka.EntityFrameworkCore.SafeMigrations.SqlServer.props"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive; compile" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="..\Doka.EntityFrameworkCore.SafeMigrations\Doka.EntityFrameworkCore.SafeMigrations.csproj" />
  </ItemGroup>

  <!-- WHY: Update-only navigation preserves SDK Compile ownership. Every parent
       is a real same-folder source; feature locations and runnable identities remain intact. -->
  <ItemGroup Label="PartialFamilyNesting">
    <Compile Update="Analysis\SqlServerSafeMigrationProviderAnalyzer.*.cs;
                     Analysis\SqlServerProjectedIndexFilterProof.cs;
                     Analysis\SqlServerProjectedSeedKeyProof.cs">
      <DependentUpon>SqlServerSafeMigrationProviderAnalyzer.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Columns\SqlServerSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationCatalogSqlBuilder.Columns'">SqlServerSafeMigrationCatalogSqlBuilder.Columns.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Columns\SqlServerSafeMigrationProviderAnalyzer.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationProviderAnalyzer.ColumnTransitions'">SqlServerSafeMigrationProviderAnalyzer.ColumnTransitions.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Constraints\CheckConstraints\SqlServerSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationCatalogSqlBuilder.CheckConstraints'">SqlServerSafeMigrationCatalogSqlBuilder.CheckConstraints.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\ForeignKeys\SqlServerProjectedDependencyGraph.*.cs">
      <DependentUpon>SqlServerProjectedDependencyGraph.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Indexes\SqlServerSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationCatalogSqlBuilder.Indexes'">SqlServerSafeMigrationCatalogSqlBuilder.Indexes.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\ModelManagedData\SqlServerSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationCatalogSqlBuilder.ModelManagedData'">SqlServerSafeMigrationCatalogSqlBuilder.ModelManagedData.cs</DependentUpon>
    </Compile>
    <Compile Update="Features\Tables\SqlServerSafeMigrationCatalogSqlBuilder.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SqlServerSafeMigrationCatalogSqlBuilder.Tables'">SqlServerSafeMigrationCatalogSqlBuilder.Tables.cs</DependentUpon>
    </Compile>
    <Compile Update="SqlGeneration\SqlServerSafeMigrationsSqlGenerator.*.cs">
      <DependentUpon>SqlServerSafeMigrationsSqlGenerator.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
