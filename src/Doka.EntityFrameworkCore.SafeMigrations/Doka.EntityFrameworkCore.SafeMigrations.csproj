<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Doka.EntityFrameworkCore.SafeMigrations</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.SafeMigrations</RootNamespace>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>Doka.EntityFrameworkCore.SafeMigrations</PackageId>
    <Description>
      Core abstractions, planning layer, and MigrationBuilder extension methods for
      Doka.EntityFrameworkCore.SafeMigrations — safe, idempotent, provider-aware EF Core
      migration operations for MariaDB and PostgreSQL.
    </Description>
    <PackageTags>efcore;entityframeworkcore;migrations;safe-migrations;idempotent;mariadb;postgresql</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
