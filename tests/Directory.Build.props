<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WHY: EF and test infrastructure bind selected members through reflection;
         these conditional IDE annotations must not become runtime assets. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" IncludeAssets="compile" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/DatabaseImageCatalog*.cs"
             Link="Infrastructure/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../docker/database-images.Dockerfile"
                      LogicalName="Doka.SafeMigrations.DatabaseImages" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/SharedContainer*.cs"
             Link="Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ProcessWideTestGroup.cs"
             Link="Infrastructure/ProcessWideTestGroup.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/OwnedTestOperationCleanup*.cs"
             Link="Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CancellationTokenContractTests.cs"
             Link="Infrastructure/CancellationTokenContractTests.cs" />
    <None Include="$(MSBuildThisFileDirectory)Shared/xunit.runner.json"
          Link="xunit.runner.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
