    <Compile Include="..\Shared\SafeMigrationLiteralContract.cs"
             Link="Infrastructure\SafeMigrationLiteralContract.cs" />
    <Compile Include="..\Shared\SafeMigrationStateSpaceGenerator.cs"
             Link="Infrastructure\SafeMigrationStateSpaceGenerator.cs" />
    <Compile Include="..\Shared\LargeMigrationStressContract.cs"
             Link="Infrastructure\LargeMigrationStressContract.cs" />
    <None Include="..\..\schemas\safe-migration-report-view-v1.schema.json"
          Link="schemas\safe-migration-report-view-v1.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-report-view-v2.schema.json"
          Link="schemas\safe-migration-report-view-v2.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-report-view-v3.schema.json"
          Link="schemas\safe-migration-report-view-v3.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-run-report-v1.schema.json"
          Link="schemas\safe-migration-run-report-v1.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-run-report-v2.schema.json"
          Link="schemas\safe-migration-run-report-v2.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-run-report-v3.schema.json"
          Link="schemas\safe-migration-run-report-v3.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\schemas\safe-migration-run-report-v4.schema.json"
          Link="schemas\safe-migration-run-report-v4.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\Doka.EntityFrameworkCore.SafeMigrations\Doka.EntityFrameworkCore.SafeMigrations.csproj" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive; compile" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- WHY: Update-only navigation preserves SDK Compile ownership. Every parent
       is a real same-folder source; feature locations and runnable identities remain intact. -->
  <ItemGroup Label="PartialFamilyNesting">
    <Compile Update="Unit\Features\Columns\SafeMigrationPreflightProjectionTests.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SafeMigrationPreflightProjectionTests.Columns'">SafeMigrationPreflightProjectionTests.Columns.cs</DependentUpon>
    </Compile>
    <Compile Update="Unit\Features\Lifecycle\SafeMigrationModelManagedKeyIdentityTests.*.cs">
      <DependentUpon>SafeMigrationModelManagedKeyIdentityTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Unit\Features\Lifecycle\SafeMigrationPostflightComputedRenameTests.*.cs">
      <DependentUpon>SafeMigrationPostflightComputedRenameTests.cs</DependentUpon>
    </Compile>
    <!-- A matching legacy filename declares a distinct runnable class, not this partial family. -->
    <Compile Update="Unit\Features\Lifecycle\SafeMigrationPreflightProjectionTests.*.cs">
      <DependentUpon Condition="'%(Filename)' != 'SafeMigrationPreflightProjectionTests.Lifecycle' and '%(Filename)' != 'SafeMigrationPreflightProjectionTests.Allocations'">SafeMigrationPreflightProjectionTests.Lifecycle.cs</DependentUpon>
    </Compile>
    <Compile Update="Unit\Features\Lifecycle\SafeMigrationRunContractTests.*.cs">
      <DependentUpon>SafeMigrationRunContractTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Unit\Features\ModelManagedData\SafeMigrationModelManagedDataTests.*.cs">
      <DependentUpon>SafeMigrationModelManagedDataTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Unit\Scaffolding\SafeMigrationScaffoldingTests.*.cs">
      <DependentUpon>SafeMigrationScaffoldingTests.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
